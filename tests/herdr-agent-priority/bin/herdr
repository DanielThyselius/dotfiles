#!/bin/sh
# Stub herdr CLI for the offline tests. Serves $FIXTURE_DIR/agents.json,
# records writes instead of sending them anywhere, and refuses (loudly, with a
# nonzero exit) any call this fixture does not model, so a script path this
# stub never learned about fails the test instead of being silently ignored.
set -eu
F=$FIXTURE_DIR
printf '%s\n' "$*" >>"$F/calls.log"
case "$1 ${2:-}" in
"agent list") cat "$F/agents.json" ;;
"pane list")
  # Test seam for the prune() guard: three ways a real `pane list` goes wrong.
  # exit    - the real CLI's failure mode: nothing usable on stdout, exit 1.
  # errjson - the real CLI's other failure mode: an {"error": ...} object on
  #           stdout (e.g. "server_not_running"), but exit 0.
  # empty   - a well-formed reply with no panes at all.
  # Unset (the default), behaviour is unchanged: serve the fixture.
  case "${HERDR_STUB_FAIL_PANE_LIST:-}" in
  exit) exit 1 ;;
  errjson) echo '{"error":{"code":"server_not_running"}}'; exit 0 ;;
  empty) echo '{"result":{"panes":[]}}' ;;
  '') jq '{result: {panes: [.result.agents[] | {pane_id, workspace_id, tab_id}]}}' "$F/agents.json" ;;
  *) echo "stub herdr: unknown HERDR_STUB_FAIL_PANE_LIST: $HERDR_STUB_FAIL_PANE_LIST" >&2; exit 1 ;;
  esac
  ;;
"workspace list")
  jq '{result: {workspaces: ([.result.agents[].workspace_id] | unique
        | map({workspace_id: ., label: ("ws-" + .)}))}}' "$F/agents.json" ;;
"tab list")
  jq '{result: {tabs: ([.result.agents[].tab_id] | unique
        | map({tab_id: ., label: ("tab-" + .)}))}}' "$F/agents.json" ;;
"pane report-metadata")
  # Test seam: HERDR_STUB_FAIL_SNOOZE_META=1 makes every write under the
  # agent-snooze source fail (nonzero, nothing logged), as a server that
  # rejects the call would. Rank writes (agent-priority) are unaffected.
  case " $* " in
  *" --source agent-snooze "*)
    if [ -n "${HERDR_STUB_FAIL_SNOOZE_META:-}" ]; then
      echo "stub herdr: forced agent-snooze failure" >&2
      exit 1
    fi
    ;;
  esac
  printf '%s\n' "$*" >>"$F/metadata.log"
  ;;
"agent focus" | "workspace focus" | "tab focus") : ;;
*)
  echo "stub herdr: unmodelled: $*" >&2
  exit 1
  ;;
esac
